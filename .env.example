# Which AI to use: anthropic, openai or gemini. Only the key for that one is needed.
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-3.5-flash-lite

# The business this assistant works for
BUSINESS_NAME=Northgate Family Dental
KNOWLEDGE_FILE=knowledge/northgate_dental_faq.md
FRONT_DESK_CONTACT=call (555) 014-2290

# Where finished leads go: the n8n AI Lead Inbox webhook (Project 4). Leave empty to only log them in data/leads.jsonl
LEAD_WEBHOOK_URL=http://localhost:5678/webhook/lead
LEAD_SIGN_OFF=Northgate Family Dental front desk

# Websites allowed to embed the widget, comma separated (* = any)
ALLOWED_ORIGINS=*
